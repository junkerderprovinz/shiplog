{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>junkerderprovinz/junkerderprovinz//renovate/base",
    "local>junkerderprovinz/junkerderprovinz//renovate/components"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Docker base images (golang build stage, distroless runtime): manual review",
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "base images",
      "commitMessagePrefix": "build:",
      "labels": [
        "base-image"
      ]
    }
  ]
}
