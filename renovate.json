{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>junkerderprovinz/junkerderprovinz//renovate/base",
    "local>junkerderprovinz/junkerderprovinz//renovate/components"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Docker base images (golang build stage, distroless runtime): manual review",
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "base images",
      "commitMessagePrefix": "build:",
      "labels": [
        "base-image"
      ]
    },
    {
      "description": "Docker: auto-merge digest pins and digest refreshes (same tag, new build). Major/minor stay open for review.",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "pinDigest",
        "digest"
      ],
      "automerge": true,
      "commitMessagePrefix": "ci:",
      "labels": [
        "docker"
      ]
    }
  ]
}
