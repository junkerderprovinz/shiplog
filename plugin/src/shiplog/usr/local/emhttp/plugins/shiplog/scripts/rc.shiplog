#!/bin/bash
# Controls the ShipLog engine, which the plugin runs as a host daemon.

NAME="shiplog"
BIN="/usr/local/emhttp/plugins/${NAME}/bin/${NAME}"
CFG="/boot/config/plugins/${NAME}/${NAME}.cfg"
PIDFILE="/var/run/${NAME}.pid"
LOG="/var/log/${NAME}.log"

# Defaults, overridden by the cfg the settings page writes as KEY="value".
ENABLE="true"
PORT="8484"
DATA_DIR="/mnt/user/appdata/shiplog"
DOCKER_SOCKET="/var/run/docker.sock"
POLL_INTERVAL=""
GITHUB_TOKEN=""
IGNORE_UNMANAGED="false"
OLLAMA_URL=""
OLLAMA_MODEL=""
MATRIX_HOMESERVER=""
MATRIX_TOKEN=""
MATRIX_ROOM=""
UNRAID_NOTIFY="false"
AUTOUPDATE_ENABLED="false"
AUTOUPDATE_LEVEL="off"
AUTOUPDATE_DIGEST="false"
AUTOUPDATE_DRYRUN="false"
AUTOUPDATE_SCHED_MODE="off"
AUTOUPDATE_SCHED_TIME="04:00"
AUTOUPDATE_SCHED_EVERY="6"
AUTOUPDATE_EXCLUDE_WORDS=""
[ -f "$CFG" ] && . "$CFG"

is_running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; }

start() {
  if [ "$ENABLE" = "false" ]; then echo "shiplog: disabled in settings"; return 0; fi
  if is_running; then echo "shiplog: already running (pid $(cat "$PIDFILE"))"; return 0; fi
  # The plugin installs before the array is mounted. Starting then would put
  # the database on the root tmpfs, wiped at every reboot, and creating
  # /mnt/user/... early can keep the user shares from mounting. event/started
  # starts the daemon once the array is up.
  probe="$DATA_DIR"
  while [ ! -e "$probe" ] && [ "$probe" != "/" ]; do probe=$(dirname "$probe"); done
  if [ "$(stat -c %d "$probe" 2>/dev/null)" = "$(stat -c %d / 2>/dev/null)" ]; then
    echo "shiplog: $DATA_DIR still on the root filesystem (array/pool not mounted yet); deferring until array-start"
    return 0
  fi
  # A package built on a filesystem without mode bits lacks the exec bit.
  [ -f "$BIN" ] && chmod +x "$BIN" 2>/dev/null
  if [ ! -x "$BIN" ]; then echo "shiplog: binary missing or not executable at $BIN"; return 1; fi
  mkdir -p "$DATA_DIR"
  export PORT DATA_DIR DOCKER_SOCKET POLL_INTERVAL GITHUB_TOKEN IGNORE_UNMANAGED \
         OLLAMA_URL OLLAMA_MODEL MATRIX_HOMESERVER MATRIX_TOKEN MATRIX_ROOM UNRAID_NOTIFY \
         AUTOUPDATE_ENABLED AUTOUPDATE_LEVEL AUTOUPDATE_DIGEST AUTOUPDATE_DRYRUN \
         AUTOUPDATE_SCHED_MODE AUTOUPDATE_SCHED_TIME AUTOUPDATE_SCHED_EVERY \
         AUTOUPDATE_EXCLUDE_WORDS
  setsid "$BIN" >>"$LOG" 2>&1 &
  echo $! >"$PIDFILE"
  # Unraid shows an rc script's stdout during array start in the footer, so the
  # start line goes to the daemon log only.
  echo "shiplog: started (pid $(cat "$PIDFILE"), port $PORT)" >>"$LOG"
}

stop() {
  local pid=""
  [ -f "$PIDFILE" ] && pid=$(cat "$PIDFILE" 2>/dev/null)
  [ -n "$pid" ] && kill "$pid" 2>/dev/null
  pkill -f "$BIN" 2>/dev/null
  # A graceful shutdown takes a few seconds, and a following start needs the
  # port free.
  for _ in $(seq 1 20); do
    pgrep -f "$BIN" >/dev/null 2>&1 || break
    sleep 0.5
  done
  pkill -9 -f "$BIN" 2>/dev/null
  rm -f "$PIDFILE"
  echo "shiplog: stopped"
}

status() {
  if is_running; then echo "shiplog: running (pid $(cat "$PIDFILE"), port $PORT)";
  else echo "shiplog: stopped"; fi
}

case "$1" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)  status ;;
  *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
