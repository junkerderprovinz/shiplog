  (function () {
    var t = null;
    try { t = localStorage.getItem('shiplog.settings.tab'); } catch (e) {}
    if (!t || t === 'general' || !document.getElementById('sl-pane-' + t)) return;
    document.querySelectorAll('#sl-cfg .sl-tab').forEach(function (b) {
      var on = b.getAttribute('data-sl-tab') === t;
      b.setAttribute('aria-selected', on ? 'true' : 'false');
      b.tabIndex = on ? 0 : -1;
    });
    document.querySelectorAll('#sl-cfg .sl-pane').forEach(function (p) { p.hidden = p.id !== 'sl-pane-' + t; });
  })();
