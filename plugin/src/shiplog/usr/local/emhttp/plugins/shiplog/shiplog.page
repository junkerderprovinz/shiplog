      <div class="sl-row" data-sl-au>
        <div class="sl-lbl"><label for="sl-au-level"><?=$slE($L['s_au_level'])?></label><?=$slInfo($L['s_au_level_desc'])?></div>
        <div class="sl-ctl">
          <select class="sl-sel" id="sl-au-level" name="AUTOUPDATE_LEVEL">
