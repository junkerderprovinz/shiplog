    font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--txt)}
  html.cc-header-on .sl-card > h3 small{text-transform:none;letter-spacing:0;font-weight:400;color:var(--dim2);font-size:12px;margin-left:0}
  html.cc-header-on .sl-row > label{color:var(--txt)}
  html.cc-header-on .sl-cfg input[type=text],
  html.cc-header-on .sl-cfg input[type=password],
  html.cc-header-on .sl-cfg select{background:var(--well);border:none;border-radius:var(--rad);color:var(--txt);
    height:34px;padding:0 11px;font-size:13px;line-height:34px;min-width:240px;outline:none;-webkit-appearance:none;appearance:none}
  html.cc-header-on .sl-cfg select{padding-right:30px;
    background-image:linear-gradient(45deg,transparent 50%,var(--dim) 50%),linear-gradient(135deg,var(--dim) 50%,transparent 50%);
    background-position:calc(100% - 15px) 15px,calc(100% - 10px) 15px;background-size:5px 5px,5px 5px;background-repeat:no-repeat}
  html.cc-header-on .sl-cfg input:focus,html.cc-header-on .sl-cfg select:focus{box-shadow:0 0 0 2px var(--accent)}
  html.cc-header-on .sl-cfg input::placeholder{color:var(--dim2)}
  html.cc-header-on .sl-cfg .sl-btn{background:var(--chip);border:none;border-radius:var(--rad);color:var(--txt);
    height:32px;min-width:0;padding:0 14px;font-size:13px;line-height:1.2;font-weight:500;letter-spacing:normal;
    text-transform:none;cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
  html.cc-header-on .sl-cfg .sl-btn:hover{background:var(--chip-h);color:var(--txt)}
  html.cc-header-on .sl-cfg .sl-btn.sl-primary{background:var(--accent);color:var(--accent-fg);font-weight:600}
  html.cc-header-on .sl-cfg .sl-btn.sl-primary:hover{filter:brightness(1.06)}
  html.cc-header-on .sl-cfg .sl-switch > input[type=checkbox]{position:absolute!important;left:0;top:0;
    width:1px!important;height:1px!important;opacity:0!important;margin:0!important;padding:0!important;overflow:hidden;clip:rect(0 0 0 0);pointer-events:none}
  html.cc-header-on .sl-track{display:block;position:relative;width:46px;height:24px;flex:none;border-radius:var(--pill);background:var(--track);transition:background .15s}
  html.cc-header-on .sl-track::after{content:"";position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#e6e6e6;transition:transform .15s,background .15s}
  html.cc-header-on .sl-switch > input:checked + .sl-track{background:var(--accent)}
  html.cc-header-on .sl-switch > input:checked + .sl-track::after{transform:translateX(22px);background:var(--accent-fg)}
  html.cc-header-on .sl-switch > input:focus-visible + .sl-track{box-shadow:0 0 0 2px var(--accent)}
  html.cc-header-on .sl-state{color:var(--txt)}
  html.cc-header-on .sl-cfg .sl-tab{background:none;border:none;color:var(--dim);min-width:0;
    padding:7px 14px;font-size:13px;line-height:1.2;font-weight:500;letter-spacing:normal;text-transform:none;cursor:pointer;border-radius:var(--rad)}
  html.cc-header-on .sl-cfg .sl-tab:hover{color:var(--txt);background:var(--chip)}
  html.cc-header-on .sl-cfg .sl-tab.active{background:color-mix(in srgb,var(--accent) 16%,transparent)!important;color:var(--accent)!important;font-weight:600}
  html.cc-header-on .sl-warn{background:var(--cc-badge-bg,#3a2a12);color:#f1c21b}
</style>

