  .sl-info-pop code{background:rgba(255,255,255,.08);padding:1px 4px;border-radius:4px;font-size:11.5px}

  /* ---------- BASE look = native Unraid (no CC): lean on Unraid's form CSS ---------- */
  .sl-card > h3{margin:14px 2px 10px;font-size:16px;font-weight:700}
  .sl-card > h3 small{font-weight:400;color:var(--dim2);font-size:12.5px;margin-left:8px}
  .sl-track{display:none}
  .sl-state{color:inherit}
  .sl-cfg .sl-tab.active{background:var(--accent)!important;background-image:none!important;color:#fff!important}
  .sl-warn{background:rgba(241,194,27,.12);border-radius:4px;color:#f1c21b;padding:10px 12px;margin:2px 0 12px;font-size:12.5px;line-height:1.45}
  /* inputs, selects, buttons: intentionally NOT styled here -> Unraid's native look */

  /* ---------- GLIMSTONE look = only when CannonadeCommand is installed ---------- */
  html.cc-header-on .sl-cfg{color:var(--txt)}
  html.cc-header-on .sl-card{background:var(--card);border-radius:var(--rad);box-shadow:0 1px 3px rgba(0,0,0,.3);padding:6px 18px 18px}
