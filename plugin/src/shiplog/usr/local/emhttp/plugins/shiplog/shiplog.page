/* The give windows. The script moves them into <body> and mounts the coffee frame
   and PayPal's buttons only while their window is open, so nothing from either
   provider loads before somebody asks for it. A QR path carries no quiet zone, so
   the four modules the standard asks for are added around it here. */
$slQr = '';
foreach ($GV['qr'] as $addr => $qr) {
  $n = $qr[0] + 8;
  $slQr .= '<div class="sl-qrpanel" data-address="'.$slE($addr).'" hidden>'
         . '<div class="sl-qr"><svg viewBox="-4 -4 '.$n.' '.$n.'" role="img" aria-label="'.$slE($addr).'" shape-rendering="crispEdges"><rect x="-4" y="-4" width="'.$n.'" height="'.$n.'" fill="#fff"/><path d="'.$qr[1].'" fill="#000"/></svg></div>'
         . '<p class="sl-addr" dir="ltr">'.$slE($addr).'</p></div>';
}
$slNets = ''; $slCoins = '';
foreach ($GV['coins'] as $c) {
  $slNets .= '<div class="sl-nets" data-coin="'.$c['id'].'" role="listbox" aria-label="'.$slE($L['s_give_networks']).'" hidden>';
  foreach ($c['networks'] as $n) {
    $slNets .= '<button type="button" role="option" class="sl-net" aria-selected="false" data-address="'.$slE($n['address']).'"'.(!empty($n['note']) ? ' data-note' : '').'>'.$slE($n['name']).'</button>';
  }
  $slNets .= '</div>';
  $m = $c['mark'];
  $slCoins .= '<button type="button" role="option" class="sl-coin" aria-selected="false" data-coin="'.$c['id'].'" aria-label="'.$slE($c['name'].' ('.$c['symbol'].')').'" title="'.$slE($c['name']).'"'
            . ' style="--sl-tile: '.$c['tile'].'; --sl-tile-ink: '.$c['ink'].'">'
            . '<span class="sl-coin-mark"><svg viewBox="'.$m['box'].'" aria-hidden="true" focusable="false"><path fill="var(--sl-mark-ink, currentColor)" d="'.$m['d'].'"/></svg></span>'
            . '<span class="sl-coin-tick">'.$slE($c['symbol']).'</span></button>';
}
/* The house's horizontal selector: one option picked, the arrow keys move the pick. */
$slSeg = function ($name, $label, $items) use ($slE) {
  $out = '<div class="sl-seg" role="radiogroup" aria-label="'.$slE($label).'" data-sl-seg="'.$name.'">';
  foreach ($items as $v => $text) $out .= '<button type="button" class="sl-seg-opt" role="radio" aria-checked="false" tabindex="-1" data-value="'.$slE($v).'">'.$slE($text).'</button>';
  return $out.'</div>';
};
$slGroup = function ($label, $control) use ($slE) {
  return '<div class="sl-group"><div class="sl-group-lbl">'.$slE($label).'</div>'.$control.'</div>';
};
?>
<div class="sl-wins" id="sl-wins" data-sl-labels="textGlyph">
<div class="sl-scrim" hidden></div>
