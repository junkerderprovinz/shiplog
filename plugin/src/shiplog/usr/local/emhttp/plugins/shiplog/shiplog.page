    --rad:  var(--cc-b-radius, 8px);
    --pill: 999px;
    max-width:820px;margin:6px auto 0;font-size:14px;line-height:1.5}
  .sl-cfg *{box-sizing:border-box}

  /* ---------- shared LAYOUT (both looks) ---------- */
  .sl-hd{display:flex;align-items:center;gap:15px;padding:0 2px 16px;margin-bottom:12px}
  .sl-hd .sl-logo{width:46px;height:46px;flex:none}
  .sl-hd .sl-ttl{font-size:21px;font-weight:600;letter-spacing:.2px}
  .sl-hd .sl-ttl b{font-weight:700}
  .sl-hd .sl-sub{margin-top:3px;color:var(--dim2);font-size:12.5px;max-width:660px}
  .sl-tabs{display:flex;gap:6px;flex-wrap:wrap;margin:0 2px 16px}
  .sl-cfg .sl-tab{margin:0}
  .sl-card{margin-bottom:14px}
  .sl-card[data-hidden="1"]{display:none}
  .sl-row{display:grid;grid-template-columns:200px minmax(0,1fr);gap:4px 14px;align-items:center;padding:6px 2px}
  .sl-row > label{font-size:13px;display:inline-flex;align-items:center;gap:6px;min-height:32px}
  .sl-row .sl-in{display:flex;align-items:center;gap:10px;flex-wrap:wrap;min-height:32px}
  .sl-in.sl-stack{flex-direction:column;align-items:flex-start;gap:8px}
  .sl-row .sl-desc{grid-column:2/-1;color:var(--dim2);font-size:12px;line-height:1.45;max-width:600px}
  .sl-cfg input.sl-narrow{width:120px;min-width:120px}
  .sl-field{position:relative;display:block;width:100%}
  .sl-field > input{width:100%;padding-right:34px}
  .sl-eyebtn{position:absolute;right:10px;top:50%;transform:translateY(-50%);
    display:inline-flex;cursor:pointer;color:var(--dim2);line-height:0;background:none;border:none;padding:0}
  .sl-eyebtn:hover{color:var(--txt)}
  .sl-eyebtn svg{width:17px;height:17px;display:block}
  input[type=password]::-ms-reveal,input[type=password]::-ms-clear{display:none}
  .sl-switch{display:inline-flex;align-items:center;gap:8px;cursor:pointer;user-select:none;position:relative}
  .sl-state{font-size:13px;min-width:26px}
  .sl-hint{color:var(--dim2);font-size:12px}
  .sl-cfg .sl-btn{margin:0}
  .sl-res{font-size:12.5px}
  .sl-res.ok{color:var(--status-ok-text,#3fae6a)}
  .sl-res.err{color:var(--status-fail-text,#d9534f)}
  .sl-res.run{color:var(--dim)}
  .sl-actions{display:flex;gap:10px;margin:6px 2px 4px}
  .sl-version{color:var(--dim2);font-size:11.5px;margin:2px 2px 0}
  .sl-cfg a{color:#8ab4f8;text-decoration:none}

  /* info bubble (both looks — neutral, never accent) */
  .sl-info{display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;
    color:var(--dim2);opacity:.7;cursor:help;flex:none;padding:0;background:none;border:none}
  .sl-info:hover,.sl-info:focus{opacity:1;outline:none;color:var(--dim)}
  .sl-info svg{width:15px;height:15px;display:block}
  .sl-info-pop{position:absolute;z-index:9999;max-width:300px;background:var(--cc-surface-window,#1c1c1c);color:var(--txt);
    border:none;border-radius:var(--rad);padding:9px 11px;font-size:12px;line-height:1.5;box-shadow:0 6px 20px rgba(0,0,0,.5)}
