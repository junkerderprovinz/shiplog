          <span class="sl-act"><a class="button sl-btn" id="sl-statuslink" href="<?=$slE($slStatusUrl)?>" target="_blank" rel="noopener noreferrer" data-sl-port="<?=$slE($port)?>"><?=$slBtn('ExternalLink', $L['s_statuspage_btn'])?></a></span>
