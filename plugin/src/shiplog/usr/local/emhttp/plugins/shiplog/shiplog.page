            <option value="patch" <?=$auLevel==='patch'?'selected':''?>><?=$slE($L['s_au_lvl_patch'])?></option>
            <option value="minor" <?=$auLevel==='minor'?'selected':''?>><?=$slE($L['s_au_lvl_minor'])?></option>
            <option value="major" <?=$auLevel==='major'?'selected':''?>><?=$slE($L['s_au_lvl_major'])?></option>
          </select>
        </div>
      </div>
      <div class="sl-row" data-sl-au>
        <div class="sl-lbl"><label for="sl-AUTOUPDATE_EXCLUDE_WORDS"><?=$slE($L['s_au_exclude'])?></label><?=$slInfo($L['s_au_exclude_desc'])?></div>
        <div class="sl-ctl"><input type="text" class="sl-f" id="sl-AUTOUPDATE_EXCLUDE_WORDS" name="AUTOUPDATE_EXCLUDE_WORDS" value="<?=$slE($auExclude)?>" placeholder="breaking, migration required"></div>
