<?php
/* Writes /boot/config/plugins/shiplog/shiplog.cfg through Unraid's /update.php
   and restarts the daemon. Unraid may include a .page more than once, so it
   declares no functions; a "Cannot redeclare" error would leave a blank page. */
$cfg    = parse_plugin_cfg("shiplog");
$enable = isset($cfg['ENABLE']) ? $cfg['ENABLE'] : 'true';
$port   = !empty($cfg['PORT'])          ? $cfg['PORT']          : '8484';
$ddir   = !empty($cfg['DATA_DIR'])      ? $cfg['DATA_DIR']      : '/mnt/user/appdata/shiplog';
$poll   = !empty($cfg['POLL_INTERVAL']) ? $cfg['POLL_INTERVAL'] : '6h';
$ghtok  = isset($cfg['GITHUB_TOKEN'])      ? $cfg['GITHUB_TOKEN']      : '';
$dhuser = isset($cfg['DOCKERHUB_USERNAME']) ? $cfg['DOCKERHUB_USERNAME'] : '';
$dhtok  = isset($cfg['DOCKERHUB_TOKEN'])    ? $cfg['DOCKERHUB_TOKEN']    : '';
$ourl   = isset($cfg['OLLAMA_URL'])        ? $cfg['OLLAMA_URL']        : '';
$omodel = isset($cfg['OLLAMA_MODEL'])      ? $cfg['OLLAMA_MODEL']      : '';
$lsurl  = isset($cfg['LLAMASWAP_URL'])     ? $cfg['LLAMASWAP_URL']     : '';
$lsmodel= isset($cfg['LLAMASWAP_MODEL'])   ? $cfg['LLAMASWAP_MODEL']   : '';
$mhs    = isset($cfg['MATRIX_HOMESERVER']) ? $cfg['MATRIX_HOMESERVER'] : '';
$mtok   = isset($cfg['MATRIX_TOKEN'])      ? $cfg['MATRIX_TOKEN']      : '';
$mroom  = isset($cfg['MATRIX_ROOM'])       ? $cfg['MATRIX_ROOM']       : '';
$unraidNotify = (isset($cfg['UNRAID_NOTIFY']) && $cfg['UNRAID_NOTIFY']==='true'); // default off
$confirm= isset($cfg['CONFIRM_UPDATE'])    ? $cfg['CONFIRM_UPDATE']    : 'true';   // default on
$silent = isset($cfg['SILENT_UPDATE'])     ? $cfg['SILENT_UPDATE']     : 'false';  // default off
$ignoreUnmanaged = (isset($cfg['IGNORE_UNMANAGED']) && $cfg['IGNORE_UNMANAGED']==='true'); // default off
/* Auto-update settings, all off by default. */
$auEn    = (isset($cfg['AUTOUPDATE_ENABLED']) && $cfg['AUTOUPDATE_ENABLED']==='true');
$auLevel = isset($cfg['AUTOUPDATE_LEVEL'])     ? $cfg['AUTOUPDATE_LEVEL']     : 'off';
$auDigest= (isset($cfg['AUTOUPDATE_DIGEST'])  && $cfg['AUTOUPDATE_DIGEST']==='true');
$auDry   = (isset($cfg['AUTOUPDATE_DRYRUN'])  && $cfg['AUTOUPDATE_DRYRUN']==='true');
$auMode  = !empty($cfg['AUTOUPDATE_SCHED_MODE'])  ? $cfg['AUTOUPDATE_SCHED_MODE']  : 'off';
$auTime  = !empty($cfg['AUTOUPDATE_SCHED_TIME'])  ? $cfg['AUTOUPDATE_SCHED_TIME']  : '04:00';
$auEvery = !empty($cfg['AUTOUPDATE_SCHED_EVERY']) ? $cfg['AUTOUPDATE_SCHED_EVERY'] : '6';
$auExclude = isset($cfg['AUTOUPDATE_EXCLUDE_WORDS']) ? $cfg['AUTOUPDATE_EXCLUDE_WORDS'] : '';
$auSkip    = isset($cfg['AUTOUPDATE_EXCLUDE_CONTAINERS']) ? $cfg['AUTOUPDATE_EXCLUDE_CONTAINERS'] : '';
/* CA Auto Update coexistence: warn so the user doesn't run both. */
$caPresent = is_dir('/usr/local/emhttp/plugins/ca.update.applications') || is_dir('/boot/config/plugins/ca.update.applications');

/* The UI text comes from the locale files, the active language over English. */
$lang = strtolower(substr((string)(isset($_SESSION['locale']) ? $_SESSION['locale'] : ''), 0, 2));
$langdir = '/usr/local/emhttp/plugins/shiplog/lang';
$L = json_decode(@file_get_contents("$langdir/en.json"), true) ?: array();
if ($lang !== 'en' && is_file("$langdir/$lang.json")) {
  $tr = json_decode(@file_get_contents("$langdir/$lang.json"), true);
  if (is_array($tr)) $L = array_merge($L, $tr);
}

/* The LAN IP for the status page link, because location.hostname cannot reach
   :PORT when the GUI is opened through myunraid.net. */
$lanip = '';
$net = '/var/local/emhttp/network.ini';
if (is_file($net) && preg_match('/IPADDR(?::0)?\s*=\s*"?([0-9.]+)/', file_get_contents($net), $mip)) $lanip = $mip[1];
if ($lanip === '' && !empty($_SERVER['SERVER_ADDR'])) $lanip = $_SERVER['SERVER_ADDR'];

$slVer = '';
if (preg_match('/<!ENTITY\s+version\s+"([^"]+)"/', (string)@file_get_contents('/var/log/plugins/shiplog.plg'), $mv)) $slVer = $mv[1];
$slGlimstoneVer = '3.7.0';

$G = include '/usr/local/emhttp/plugins/shiplog/include/glyphs.php';
$slE = function ($s) { return htmlspecialchars((string)$s, ENT_QUOTES); };
/* A help text in the locale files may carry markup; its bubble shows the words. */
$slPlain = function ($html) { return trim(preg_replace('/\s+/', ' ', html_entity_decode(strip_tags((string)$html), ENT_QUOTES, 'UTF-8'))); };
$slInfoSvg = '<svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.3"/><circle cx="8" cy="4.6" r="0.9" fill="currentColor"/><path d="M8 7v4.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>';
$slInfo = function ($html) use ($slE, $slPlain, $slInfoSvg) {
  $t = $slE($slPlain($html));
  return '<span class="sl-info" tabindex="0" role="img" aria-label="'.$t.'" data-sl-tip="'.$t.'">'.$slInfoSvg.'</span>';
};
$slBtn = function ($glyph, $label) use ($G, $slE) {
  return '<span class="sl-g">'.$G[$glyph].'</span><span class="sl-l">'.$slE($label).'</span>';
};
/* A link inside a help text stands beside its control as a badge. */
$slLinks = function ($html) use ($slBtn, $slE, $slPlain) {
  $out = '';
  if (preg_match_all('/<a\s[^>]*href="([^"]+)"[^>]*>(.*?)<\/a>/i', (string)$html, $m, PREG_SET_ORDER)) {
    foreach ($m as $a) $out .= '<a class="button sl-btn" href="'.$slE($a[1]).'" target="_blank" rel="noopener noreferrer">'.$slBtn('ExternalLink', $slPlain($a[2])).'</a>';
  }
  return $out;
};
/* The checkbox carries no name; its hidden twin posts true or false, as Unraid's cfg expects. */
$slSwitch = function ($id, $name, $on) {
  return '<input type="checkbox" role="switch" class="sl-sw" id="'.$id.'-cb" data-sl-mirror="'.$id.'"'.($on ? ' checked' : '').'>'
       . '<input type="hidden" name="'.$name.'" id="'.$id.'" value="'.($on ? 'true' : 'false').'">';
};
$slEye = function ($id) use ($G, $slE, $L) {
  return '<span class="sl-eye" role="button" tabindex="0" data-sl-eye="'.$id.'" aria-label="'.$slE($L['s_show']).'" aria-pressed="false">'.$G['Eye'].'</span>';
};
$slStatusUrl = $lanip !== '' ? 'http://'.$lanip.':'.$port.'/' : '';
